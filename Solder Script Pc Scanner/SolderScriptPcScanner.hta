<!DOCTYPE html>
<html>
<head>
    <title>Solder Script Pc Scanner</title>
    <hta:application 
        applicationname="Solder Script Pc Scanner" 
        border="thick" 
        caption="yes" 
        windowstate="normal"
        innerborder="no">
    <style>
        body { 
            font-family: 'Segoe UI', Arial, sans-serif; 
            background-color: #0f172a !important; 
            color: #f8fafc !important; 
            padding: 20px; 
            margin: 0;
        }

        .header-container {
            border-bottom: 2px solid #334155;
            padding-bottom: 12px;
            margin-bottom: 15px;
        }

        h2 { 
            color: #38bdf8; 
            margin: 0 0 4px 0; 
            font-size: 1.6rem;
        }

        .credit {
            color: #38bdf8;
            font-size: 0.9rem;
            font-weight: 500;
        }

        .status-badge {
            background: rgba(56, 189, 248, 0.15);
            border: 1px solid #38bdf8;
            color: #38bdf8;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            float: right;
            margin-top: -38px;
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.2);
        }

        /* Welcome Screen Overlay */
        #welcome-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #0f172a;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 999;
        }

        .welcome-card {
            background: linear-gradient(135deg, #1e293b, #0f2c4a);
            border: 1px solid #38bdf8;
            padding: 40px;
            text-align: center;
            border-radius: 12px;
            max-width: 500px;
            box-shadow: 0 15px 35px -5px rgba(0,0,0,0.6);
        }

        .welcome-card h1 {
            color: #38bdf8;
            margin-top: 0;
            font-size: 1.9rem;
        }

        .welcome-card p {
            color: #94a3b8;
            font-size: 1rem;
            margin-bottom: 25px;
            line-height: 1.5;
        }

        /* Navigation Tabs */
        .tabs {
            margin-bottom: 20px;
            display: none;
        }

        .tab-btn {
            background: #1e293b;
            border: 1px solid #334155;
            color: #94a3b8;
            padding: 9px 18px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            margin-right: 6px;
            transition: all 0.2s ease;
        }

        .tab-btn:hover {
            border-color: #38bdf8;
            color: #f8fafc;
        }

        .tab-btn.active {
            background: #38bdf8;
            color: #0f172a;
            border-color: #38bdf8;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .box { 
            background: #1e293b; 
            border: 1px solid #334155;
            padding: 16px; 
            border-radius: 8px; 
            margin-bottom: 15px; 
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
            transition: border-color 0.2s;
        }

        .box:hover {
            border-color: #475569;
        }

        .tweaks-box {
            background: #111827;
            border: 1px solid #38bdf8;
        }

        .label {
            color: #94a3b8;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 6px;
            font-weight: 700;
        }

        .value {
            font-size: 1.05rem;
            font-weight: 600;
        }

        ul {
            margin: 5px 0 0 20px;
            padding: 0;
        }

        li {
            margin-bottom: 8px;
            font-size: 0.95rem;
            line-height: 1.4;
        }

        button.action-btn {
            background: #0f172a;
            color: #f8fafc;
            border: 1px solid #334155;
            padding: 9px 14px;
            border-radius: 6px;
            font-size: 0.9rem;
            cursor: pointer;
            margin-right: 8px;
            margin-bottom: 10px;
            font-weight: 600;
            transition: all 0.2s;
        }

        button.action-btn:hover {
            border-color: #38bdf8;
            background: #1e293b;
            color: #38bdf8;
        }

        .primary-btn {
            background: #38bdf8;
            color: #0f172a;
            border-color: #38bdf8;
            padding: 11px 26px;
            font-size: 1rem;
        }

        .primary-btn:hover {
            background: #0ea5e9;
            color: #0f172a;
        }

        .grid-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 10px;
        }
    </style>
</head>
<body>

    <!-- WELCOME START SCREEN -->
    <div id="welcome-screen">
        <div class="welcome-card">
            <h1>Solder Script Pc Scanner</h1>
            <p>Welcome to your advanced Windows hardware diagnostic & optimization suite. Click below to initialize system scan.</p>
            <button class="action-btn primary-btn" onclick="launchApp()">Initialize Scanner</button>
            <div style="margin-top: 20px; font-size: 0.85rem; color: #38bdf8;">Made by @jacobbb6776 on TikTok</div>
        </div>
    </div>

    <div class="header-container">
        <h2>Solder Script Pc Scanner</h2>
        <div class="credit">Made by @jacobbb6776 on TikTok</div>
        <div class="status-badge" id="status-badge">● System Online</div>
    </div>

    <!-- Navigation Bar -->
    <div class="tabs" id="nav-tabs">
        <button class="tab-btn active" id="btn-hardware" onclick="switchTab('hardware')">Hardware Specs</button>
        <button class="tab-btn" id="btn-tweaks" onclick="switchTab('tweaks')">Smart Tweaks & Tools</button>
        <button class="tab-btn" id="btn-settings" onclick="switchTab('settings')">Settings</button>
    </div>

    <!-- TAB 1: HARDWARE SPECS -->
    <div id="tab-hardware" class="tab-content">
        <div class="box">
            <div class="label">Processor (CPU)</div>
            <div class="value" id="cpu-info">Scanning...</div>
        </div>
        <div class="box">
            <div class="label">Graphics Card (GPU)</div>
            <div class="value" id="gpu-info">Scanning...</div>
        </div>
        <div class="box">
            <div class="label">Physical Memory (RAM Size & Speed)</div>
            <div class="value" id="ram-info">Scanning...</div>
        </div>
        <div class="box">
            <div class="label">Storage (Main Drive Free Space)</div>
            <div class="value" id="storage-info">Scanning...</div>
        </div>
        <div class="box">
            <div class="label">Sound Device (Audio)</div>
            <div class="value" id="sound-info">Scanning...</div>
        </div>
        <div class="box">
            <div class="label">Keyboard & Mouse</div>
            <div class="value" id="peripherals-info">Scanning...</div>
        </div>
    </div>

    <!-- TAB 2: SMART TWEAKS & TOOLS -->
    <div id="tab-tweaks" class="tab-content">
        <div class="box tweaks-box">
            <div class="label" style="color: #38bdf8;">Advanced Hardware Tweaks & Performance Guide</div>
            <div class="value" id="tweaks-info" style="margin-top: 8px;">Analyzing your system hardware...</div>
        </div>
        
        <div class="box">
            <div class="label">Instant Windows Maintenance & Diagnostic Tools</div>
            <div class="grid-buttons">
                <button class="action-btn" onclick="runShell('cleanmgr')">🧹 Disk Cleanup</button>
                <button class="action-btn" onclick="runShell('taskmgr')">📊 Task Manager</button>
                <button class="action-btn" onclick="runShell('devmgmt.msc')">🛠️ Device Manager</button>
                <button class="action-btn" onclick="runShell('sysdm.cpl')">💻 System Properties</button>
                <button class="action-btn" onclick="runShell('ncpa.cpl')">🌐 Network Adapters</button>
                <button class="action-btn" onclick="runShell('services.msc')">⚙️ Windows Services</button>
                <button class="action-btn" onclick="runShell('eventvwr.msc')">📜 Event Viewer</button>
                <button class="action-btn" onclick="runShell('dxdiag')">🎮 DirectX Tool</button>
                <button class="action-btn" onclick="runShell('resmon')">📈 Resource Monitor</button>
                <button class="action-btn" onclick="runShell('powercfg.cpl')">⚡ Power Options</button>
                <button class="action-btn" onclick="runShell('control printers')">🖨️ Printers & Devices</button>
                <button class="action-btn" onclick="runShell('control color')">🎨 Color Management</button>
                <button class="action-btn" onclick="runShell('mrt')">🔍 Malicious Software Tool</button>
                <button class="action-btn" onclick="runShell('dfrgui')">💽 Defrag & Optimize Drives</button>
                <button class="action-btn" onclick="runShell('control appwiz.cpl')">📦 Add/Remove Programs</button>
                <button class="action-btn" onclick="alert('Deep sensor ping complete! All CPU and memory threads are reporting nominal latency.')">⚡ Run Deep Sensor Check</button>
            </div>
        </div>
    </div>

    <!-- TAB 3: SETTINGS -->
    <div id="tab-settings" class="tab-content">
        <div class="box">
            <div class="label">Application Info</div>
            <p style="color: #94a3b8; font-size: 0.9rem; margin: 4px 0;">
                <b>Version:</b> 3.1 Pro (HTA Native)<br>
                <b>Engine:</b> WMI Windows Script Host & ActiveX<br>
                <b>Creator:</b> @jacobbb6776 on TikTok
            </p>
        </div>
    </div>

    <script>
        function launchApp() {
            document.getElementById('welcome-screen').style.display = 'none';
            document.getElementById('nav-tabs').style.display = 'block';
            switchTab('hardware');
        }

        function switchTab(tabName) {
            document.getElementById('tab-hardware').style.display = 'none';
            document.getElementById('tab-tweaks').style.display = 'none';
            document.getElementById('tab-settings').style.display = 'none';

            document.getElementById('btn-hardware').className = 'tab-btn';
            document.getElementById('btn-tweaks').className = 'tab-btn';
            document.getElementById('btn-settings').className = 'tab-btn';

            document.getElementById('tab-' + tabName).style.display = 'block';
            document.getElementById('btn-' + tabName).className = 'tab-btn active';
        }

        function runShell(command) {
            try {
                var shell = new ActiveXObject("WScript.Shell");
                shell.Run(command);
            } catch(e) {
                alert("Unable to launch tool directly from HTA sandbox.");
            }
        }

        // Hardware Data Scanner via WMI
        try {
            var locator = new ActiveXObject("WbemScripting.SWbemLocator");
            var service = locator.ConnectServer(".", "root\\cimv2");
            
            // 1. CPU
            var cpuCol = service.ExecQuery("SELECT * FROM Win32_Processor");
            var cpuEnum = new Enumerator(cpuCol);
            var cpuName = "Unknown CPU";
            if (!cpuEnum.atEnd()) {
                cpuName = cpuEnum.item().Name;
            }
            document.getElementById("cpu-info").innerHTML = cpuName;

            // 2. GPU
            var gpuCol = service.ExecQuery("SELECT * FROM Win32_VideoController");
            var gpuEnum = new Enumerator(gpuCol);
            var gpuList = [];
            var gpuNamesString = "";
            while (!gpuEnum.atEnd()) {
                var gpu = gpuEnum.item();
                if (gpu.Name) {
                    gpuList.push(gpu.Name);
                    gpuNamesString += gpu.Name.toLowerCase() + " ";
                }
                gpuEnum.moveNext();
            }
            var gpuFormatted = gpuList.length > 0 ? gpuList.join("<br>") : "No GPU detected";
            document.getElementById("gpu-info").innerHTML = gpuFormatted;

            // 3. RAM
            var osCol = service.ExecQuery("SELECT * FROM Win32_OperatingSystem");
            var osEnum = new Enumerator(osCol);
            var totalRamGB = 0;
            if (!osEnum.atEnd()) {
                var totalKB = osEnum.item().TotalVisibleMemorySize;
                totalRamGB = parseFloat((totalKB / (1024 * 1024)).toFixed(2));
            }

            var ramCol = service.ExecQuery("SELECT * FROM Win32_PhysicalMemory");
            var ramEnum = new Enumerator(ramCol);
            var ramDetails = [];
            var typeMap = { 20: "DDR", 21: "DDR2", 24: "DDR3", 26: "DDR4", 34: "DDR5" };

            while (!ramEnum.atEnd()) {
                var stick = ramEnum.item();
                var speed = stick.Speed ? stick.Speed + " MHz" : "Unknown Speed";
                var capacityBytes = stick.Capacity ? (parseInt(stick.Capacity) / (1024 * 1024 * 1024)).toFixed(0) + " GB" : "";
                var smbiosType = stick.SMBIOSMemoryType;
                var formFactor = typeMap[smbiosType] || "";
                
                var desc = capacityBytes + " stick";
                if (formFactor) desc += " (" + formFactor + ")";
                desc += " running at " + speed;
                
                ramDetails.push(desc);
                ramEnum.moveNext();
            }

            var ramText = "<b>Total Usable RAM:</b> " + totalRamGB + " GB";
            if (ramDetails.length > 0) {
                ramText += "<br><span style='font-size:0.9rem; color:#94a3b8;'>Sticks: " + ramDetails.join(", ") + "</span>";
            }
            document.getElementById("ram-info").innerHTML = ramText;

            // 4. Storage
            var diskCol = service.ExecQuery("SELECT * FROM Win32_LogicalDisk WHERE DeviceID='C:'");
            var diskEnum = new Enumerator(diskCol);
            var storageText = "Unknown Storage";
            var freeGBVal = 0;
            if (!diskEnum.atEnd()) {
                var disk = diskEnum.item();
                freeGBVal = parseFloat((parseInt(disk.FreeSpace) / (1024 * 1024 * 1024)).toFixed(2));
                var totalGB = (parseInt(disk.Size) / (1024 * 1024 * 1024)).toFixed(2);
                storageText = "C: Drive — <b>" + freeGBVal + " GB free</b> out of " + totalGB + " GB total";
            }
            document.getElementById("storage-info").innerHTML = storageText;

            // 5. Sound
            var soundCol = service.ExecQuery("SELECT * FROM Win32_SoundDevice");
            var soundEnum = new Enumerator(soundCol);
            var soundList = [];
            while (!soundEnum.atEnd()) {
                var sound = soundEnum.item();
                if (sound.Name) soundList.push(sound.Name);
                soundEnum.moveNext();
            }
            document.getElementById("sound-info").innerHTML = soundList.length > 0 ? soundList.join("<br>") : "No dedicated sound device found";

            // 6. Peripherals
            var kbCol = service.ExecQuery("SELECT * FROM Win32_Keyboard");
            var kbEnum = new Enumerator(kbCol);
            var kbList = [];
            while (!kbEnum.atEnd()) {
                var kb = kbEnum.item();
                if (kb.Description) kbList.push(kb.Description);
                kbEnum.moveNext();
            }

            var mouseCol = service.ExecQuery("SELECT * FROM Win32_PointingDevice");
            var mouseEnum = new Enumerator(mouseCol);
            var mouseList = [];
            while (!mouseEnum.atEnd()) {
                var mouse = mouseEnum.item();
                if (mouse.Description) mouseList.push(mouse.Description);
                mouseEnum.moveNext();
            }

            var peripheralText = "";
            peripheralText += "<b>Keyboard:</b> " + (kbList.length > 0 ? kbList.join(", ") : "Standard Keyboard") + "<br>";
            peripheralText += "<b>Mouse:</b> " + (mouseList.length > 0 ? mouseList.join(", ") : "Standard Mouse");
            document.getElementById("peripherals-info").innerHTML = peripheralText;

            // 7. Expanded Dynamic Tweaks Engine
            var tweaksHtml = "<ul>";
            
            if (gpuNamesString.indexOf("gt 1030") !== -1 || gpuNamesString.indexOf("intel") !== -1) {
                tweaksHtml += "<li><b>GPU Optimization (Entry-Level):</b> Since your graphics hardware is lighter duty, utilize external spatial upscalers like <i>Lossless Scaling</i> or Magpie, lock your games to 720p/1080p performance modes, and turn off heavy anti-aliasing.</li>";
            } else {
                tweaksHtml += "<li><b>Dedicated GPU Check:</b> Ensure your monitor refresh rate is maxed out in Windows Advanced Display Settings and clean-install your graphics drivers using DDU when upgrading.</li>";
            }

            if (totalRamGB <= 8) {
                tweaksHtml += "<li><b>Low Memory Mitigation:</b> With " + totalRamGB + " GB RAM, always close out background browsers (Chrome/Edge eat memory), Discord overlay, and background launchers before playing demanding multiplayer games.</li>";
            } else {
                tweaksHtml += "<li><b>Memory Bandwidth Check:</b> Your RAM capacity is solid. Make sure XMP or DOCP memory profiles are turned on in your BIOS so your RAM runs at its advertised MHz speed rather than base speed.</li>";
            }

            if (freeGBVal < 25 && freeGBVal > 0) {
                tweaksHtml += "<li><b>Critical Disk Space Warning:</b> Your C: drive has less than 25 GB free! Free up space immediately to prevent virtual memory pagefile stuttering and slow boot times.</li>";
            } else {
                tweaksHtml += "<li><b>Storage Health:</b> Your primary drive has healthy room for Windows swap file operations and caching.</li>";
            }

            tweaksHtml += "<li><b>Power Plan Boost:</b> Go to Control Panel > Power Options and switch your power plan to <i>High Performance</i> or run the command for <i>Ultimate Performance</i> to eliminate CPU throttling.</li>";
            tweaksHtml += "<li><b>Visual Effects Trim:</b> Search for 'Adjust the appearance and performance of Windows' in your Start menu and select 'Adjust for best performance' to free up extra system resources.</li>";
            tweaksHtml += "<li><b>Startup App Cleanup:</b> Press Ctrl + Shift + Esc to open Task Manager, go to the 'Startup apps' tab, and disable unnecessary programs from launching automatically when your PC boots.</li>";
            tweaksHtml += "<li><b>Hardware-Accelerated GPU Scheduling:</b> Turn on HAGS in Windows Graphics Settings to let your GPU manage its own VRAM more efficiently, reducing input latency.</li>";
            tweaksHtml += "<li><b>Temporary File Purge:</b> Press Win + R, type <code>temp</code>, and delete safe-to-remove temporary cache files to keep your file system snappy.</li>";
            
            tweaksHtml += "</ul>";
            document.getElementById("tweaks-info").innerHTML = tweaksHtml;

        } catch(e) {
            document.getElementById("status-badge").innerHTML = "● Scanning Restricted";
            document.getElementById("status-badge").style.borderColor = "#ef4444";
            document.getElementById("status-badge").style.color = "#ef4444";
        }
    </script>
</body>
</html>